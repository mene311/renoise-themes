<%
  const pageNumber = Math.max(1, parseInt(typeof page !== 'undefined' ? page : 1, 10) || 1);
  const totalPageCount = Math.max(1, parseInt(typeof totalPages !== 'undefined' ? totalPages : 1, 10) || 1);
  let pageTitle = 'Renoise Theme Share — browse and download .xrnc themes';
  let pageDescription = 'Browse, preview, and download community Renoise color themes with generated palettes and tags.';

  if (searchQuery) {
    pageTitle = 'Search: ' + searchQuery + (pageNumber > 1 ? ' — page ' + pageNumber : '') + ' — Renoise Theme Share';
    pageDescription = 'Search Renoise color themes for "' + searchQuery + '"' + (filterTag ? ' in ' + filterTag : '') + '.';
  } else if (filterTag) {
    pageTitle = filterTag.charAt(0).toUpperCase() + filterTag.slice(1) + ' Renoise themes' + (pageNumber > 1 ? ' — page ' + pageNumber : '') + ' — Renoise Theme Share';
    pageDescription = 'Browse Renoise color themes tagged ' + filterTag + '.';
  } else if (pageNumber > 1) {
    pageTitle = 'Renoise Theme Share — page ' + pageNumber;
  } else if (sort === 'popular') {
    pageDescription = 'Browse the most popular Renoise color themes, previews, palettes, and downloads.';
  }

  const baseUrl = canonicalUrl.split('?')[0];
  const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Renoise Theme Share',
    url: baseUrl,
    potentialAction: {
      '@type': 'SearchAction',
      target: baseUrl + '?q={search_term_string}',
      'query-input': 'required name=search_term_string'
    }
  };
%>
<%- include('partials/header', { pageTitle, pageDescription, jsonLd, paginationPrevUrl, paginationNextUrl }) %>

<section class="page-intro" style="margin: 0 0 16px; max-width: 72ch;">
  <h1 style="margin: 0 0 8px;">Renoise color themes, previews, and downloads</h1>
  <p style="margin: 0 0 8px;">Browse community .xrnc themes, inspect generated previews, and download the originals. Search by tag, author, or color mood.</p>
  <p style="margin: 0; display: flex; gap: 12px; flex-wrap: wrap;">
    <a href="/tutorial">Theme tutorial</a>
    <a href="/create">Open the creator</a>
    <a href="/how-it-works">How previews work</a>
  </p>
</section>

<!-- What's New Banner -->
<div class="welcome-banner" id="welcomeBanner" hidden>  <span class="welcome-icon">◈</span>  <div class="welcome-text">    &ldquo;<%= splashQuote %>&rdquo;  </div>  <button class="welcome-close" id="closeWelcome" aria-label="Dismiss">×</button></div>

<% if (totalPageCount > 1) { %>
<nav class="pagination" aria-label="Browse pages" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin:0 0 16px;">
  <span class="pagination-current">Page <%= pageNumber %> of <%= totalPageCount %></span>
  <div style="display:flex;gap:8px;flex-wrap:wrap;">
    <% if (paginationPrevUrl) { %><a href="<%= paginationPrevUrl %>" rel="prev">← Previous</a><% } %>
    <% if (paginationNextUrl) { %><a href="<%= paginationNextUrl %>" rel="next">Next →</a><% } %>
  </div>
</nav>
<% } %>

<div class="tracker-layout" aria-label="Renoise theme browser">

  <!-- LEFT: Theme Gallery -->
  <section class="track-list" aria-label="Theme gallery">
    <div class="gallery-header" aria-hidden="true">
      <span>Themes</span>
      <span class="gallery-count"><%= totalCount %> total</span>
    </div>

    <% if (filterTag) { %>
      <div class="active-filter-bar">
        <span>Filter: <strong><%= filterTag %></strong></span>
        <a href="/<%= sort !== 'newest' ? '?sort=' + sort : '' %>" class="clear-filter">✕ clear</a>
      </div>
    <% } %>

    <div class="track-list-body theme-grid"
         id="themeGrid"
         data-total="<%= totalCount %>"
         data-loaded="<%= themes.length %>"
         data-tag="<%= filterTag || '' %>"
         data-q="<%= searchQuery || '' %>"
         data-sort="<%= sort %>">

      <% if (themes.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon" aria-hidden="true">◈</div>
          <h2>No themes found</h2>
          <p>Try a different search or be the first to share.</p>
          <a href="/upload" class="btn-submit" style="width:auto; padding: 6px 16px; margin-top: 8px;">Upload a Theme</a>
        </div>
      <% } else { %>
        <% themes.forEach((theme, i) => { %>
          <%- include('partials/theme-card', { theme }) %>
        <% }); %>
      <% } %>
    </div>

    <% if (pageNumber === 1 && themes.length > 0) { %>
      <div id="loadMoreSentinel" class="load-more-sentinel" aria-hidden="true">
        <span class="load-more-spinner">Loading more themes…</span>
      </div>
    <% } %>
  </section>

  <!-- RIGHT: Filter / Detail Panel -->
  <aside class="side-panel" aria-label="Filters and controls">

    <!-- Search -->
    <div class="panel-section">
      <h3>Search</h3>
      <div class="cmd-search">
        <label for="searchInput" class="sr-only">Search themes</label>
        <input type="search" id="searchInput" placeholder="type to filter…" autocomplete="off"
          value="<%= typeof searchQuery !== 'undefined' && searchQuery ? searchQuery : '' %>">
      </div>
      <p class="panel-stat" style="margin-top:6px"><strong id="themeCount"><%= themes.length %></strong> theme<%= themes.length !== 1 ? 's' : '' %></p>
    </div>

    <!-- Tags -->
    <div class="panel-section">
      <h3>Tags</h3>
      <div class="tag-grid" role="group" aria-label="Filter by tag">
        <a href="/<%= sort !== 'newest' ? '?sort=' + sort : '' %>"
           class="tag-btn <%= !filterTag ? 'active' : '' %>">all</a>
        <% allTags.filter(t => t.count > 0).forEach(t => { %>
          <a href="/?tag=<%= t.name %><%= sort !== 'newest' ? '&sort=' + sort : '' %>"
             class="tag-btn tag-<%= t.name %> <%= filterTag === t.name ? 'active' : '' %>">
            <%= t.name %>
            <span class="tag-count"><%= t.count %></span>
          </a>
        <% }); %>
      </div>
    </div>

    <!-- Sort -->
    <div class="panel-section">
      <h3>Sort</h3>
      <div class="sort-group" role="radiogroup" aria-label="Sort themes">
        <% const sorts = [
          { key: 'newest', label: 'Newest' },
          { key: 'popular', label: 'Popular' },
          { key: 'downloads', label: 'Downloads' },
          { key: 'oldest', label: 'Oldest' }
        ]; %>
        <% sorts.forEach(s => { %>
          <a href="/?<%= filterTag ? 'tag=' + filterTag + '&' : '' %>sort=<%= s.key %>"
             class="sort-option <%= sort === s.key ? 'active' : '' %>"
             role="radio"
             aria-checked="<%= sort === s.key %>">
            <%= s.label %>
          </a>
        <% }); %>
      </div>
    </div>

    <!-- Keyboard hints -->
    <div class="panel-section" style="margin-top:auto; border-top:1px solid var(--chrome-border);">
      <h3>Shortcuts</h3>
      <div style="font-size:14px; color:var(--chrome-text-dim); line-height:1.8;">
        <div><kbd>/</kbd> focus search</div>
        <div><kbd>↑</kbd><kbd>↓</kbd> navigate themes</div>
        <div><kbd>Enter</kbd> open theme</div>
      </div>
    </div>

  </aside>
</div>

<% if (totalPageCount > 1) { %>
<nav class="pagination" aria-label="Browse pages" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin:16px 0 0;">
  <span class="pagination-current">Page <%= pageNumber %> of <%= totalPageCount %></span>
  <div style="display:flex;gap:8px;flex-wrap:wrap;">
    <% if (paginationPrevUrl) { %><a href="<%= paginationPrevUrl %>" rel="prev">← Previous</a><% } %>
    <% if (paginationNextUrl) { %><a href="<%= paginationNextUrl %>" rel="next">Next →</a><% } %>
  </div>
</nav>
<% } %>

<%- include('partials/footer') %>
