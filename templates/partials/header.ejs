<!DOCTYPE html>
<html lang="en" data-theme="<%= uiTheme %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <% const metaTitle = typeof pageTitle !== 'undefined' ? pageTitle : 'Renoise Theme Share — browse and download .xrnc themes'; %>
  <% const metaDescription = typeof pageDescription !== 'undefined' ? pageDescription : 'Browse, preview, and download Renoise color themes with generated palettes and tags.'; %>
  <% const metaRobots = typeof pageRobots !== 'undefined' ? pageRobots : 'index,follow'; %>
  <% const metaType = typeof ogType !== 'undefined' ? ogType : 'website'; %>
  <% const metaImage = typeof ogImage !== 'undefined' && ogImage ? ogImage : null; %>
  <title><%= metaTitle %></title>
  <meta name="description" content="<%= metaDescription %>">
  <meta name="robots" content="<%= metaRobots %>">

  <meta property="og:site_name" content="Renoise Theme Share">
  <meta property="og:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : metaTitle %>">
  <meta property="og:description" content="<%= typeof ogDescription !== 'undefined' ? ogDescription : metaDescription %>">
  <meta property="og:type" content="<%= metaType %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <link rel="canonical" href="<%= canonicalUrl %>">
  <% if (typeof paginationPrevUrl !== 'undefined' && paginationPrevUrl) { %>
  <link rel="prev" href="<%= paginationPrevUrl %>">
  <% } %>
  <% if (typeof paginationNextUrl !== 'undefined' && paginationNextUrl) { %>
  <link rel="next" href="<%= paginationNextUrl %>">
  <% } %>
  <% if (metaImage) { %>
  <meta property="og:image" content="<%= metaImage %>">
  <% } %>
  <meta name="twitter:card" content="<%= metaImage ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= typeof twitterTitle !== 'undefined' ? twitterTitle : (typeof ogTitle !== 'undefined' ? ogTitle : metaTitle) %>">
  <meta name="twitter:description" content="<%= typeof twitterDescription !== 'undefined' ? twitterDescription : (typeof ogDescription !== 'undefined' ? ogDescription : metaDescription) %>">
  <% if (metaImage) { %>
  <meta name="twitter:image" content="<%= metaImage %>">
  <% } %>
  <% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
  <script type="application/ld+json"><%- JSON.stringify(jsonLd).replace(/</g, '\\u003c') %></script>
  <% } %>

  <style><%- _css %></style>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo" aria-label="Renoise Theme Share home">
        <span class="logo-icon" aria-hidden="true">◈</span>
        <span class="logo-text">Renoise<strong>Themes</strong></span>
      </a>

      <div class="header-search">
        <label for="headerSearchInput" class="sr-only">Search themes</label>
        <input type="search" id="headerSearchInput" placeholder="Search…" autocomplete="off" aria-label="Search themes">
      </div>

      <button class="header-menu-toggle" id="headerMenuToggle" type="button" aria-controls="headerNav" aria-expanded="false">
        Menu
      </button>

      <nav class="header-nav" id="headerNav" aria-label="Main navigation">
        <a href="/">Browse</a>
          <a href="/tutorial">Tutorial</a>
          <a href="/create">Create</a>
        <% if (user) { %>
          <a href="/upload" class="btn-nav-upload">Upload</a>
          <a href="/backstage">Backstage</a>
          <% if (user.rank_level >= 10) { %><a href="/admin">Admin</a><% } %>
          <span class="nav-sep" aria-hidden="true"></span>
          <div class="user-menu" aria-label="User menu">
            <span class="user-avatar" aria-hidden="true"><%= user.username.charAt(0).toUpperCase() %></span>
            <a href="/backstage" class="user-name"><%= user.username %></a>
          </div>
          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Log in</a>
          <a href="/register" class="btn-nav-upload">Sign up</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="container" id="main-content">
